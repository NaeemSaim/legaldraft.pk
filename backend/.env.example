# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the real values.
# NEVER commit the real .env — it holds your keys.
# ---------------------------------------------------------------------------

# Claude API key (from console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# A long random string. Protects the admin endpoints and the #/admin page.
ADMIN_TOKEN=change-me-to-something-long-and-random

# The public address of your FRONT END. Used to build the links inside
# verification and password-reset emails.
PUBLIC_URL=http://localhost:5173

# Which origins may call this API. Comma-separated, no trailing slash.
# Leave blank in local development to allow everything.
ALLOWED_ORIGINS=

# How many proxies sit in front of this server (hosts like Render use at least
# one). The rate limits use it to find each customer's real address. Leave blank
# only when nothing is in front of the server, as in local development.
TRUST_PROXY_HOPS=

# Where customer data and uploads are written.
# IMPORTANT: on hosts with an ephemeral filesystem (Render's free tier and
# most defaults) the app folder is WIPED on every redeploy. Point this at a
# mounted persistent disk, e.g. /var/data
DATA_DIR=

# Email sending. Without these, verification links are printed to the server
# console instead of being emailed — fine for testing, not for real users.
# For Gmail you must use an App Password, not your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=LegalDraft.pk <no-reply@legaldraft.pk>

PORT=3001
