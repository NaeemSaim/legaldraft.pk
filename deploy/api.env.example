# ---------------------------------------------------------------------------
# Production settings for the LegalDraft.pk API on the Oracle VM.
# setup-server.sh copies this to /etc/legaldraft/api.env (readable by root
# only) and generates ADMIN_TOKEN. Edit it there, never in git:
#     sudo nano /etc/legaldraft/api.env
#     sudo systemctl restart legaldraft-api
#
# Values with spaces must be in double quotes.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=3001

# Customer data and payment screenshots. Backed up nightly by backup.sh.
DATA_DIR=/var/lib/legaldraft

# Caddy is the one proxy in front of the app. Keep the api. DNS record on
# "DNS only" (grey cloud) in Cloudflare, or this number is wrong.
TRUST_PROXY_HOPS=1

# The front end's address (used in email links) and the origins allowed to call
# the API. Add https://<project>.pages.dev to ALLOWED_ORIGINS while testing on
# Cloudflare's preview address.
PUBLIC_URL=https://legaldraft.pk
ALLOWED_ORIGINS=https://legaldraft.pk,https://www.legaldraft.pk

# From console.anthropic.com
ANTHROPIC_API_KEY=

# Guards the admin endpoints and #/admin. Generated by setup-server.sh.
ADMIN_TOKEN=__GENERATE_ME__

# Email. For Gmail: SMTP_HOST=smtp.gmail.com and an App Password in SMTP_PASS.
# Gmail sends as SMTP_USER whatever MAIL_FROM says, unless you add MAIL_FROM's
# address as a "Send mail as" alias in Gmail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="LegalDraft.pk <no-reply@legaldraft.pk>"

# Never set EMAIL_DEV_MODE on this server.
